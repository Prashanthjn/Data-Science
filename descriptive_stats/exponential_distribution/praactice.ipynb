   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt \n",
    "import seaborn as sns\n",
    "\n",
    "lam=1.5\n",
    "\n",
    "data=np.random.exponential(1/lam,1000)\n",
    "sns.histplot(data,kde=True)\n",
    "plt.title(\"exponential distribution\")\n",
    "plt.ylabel(\"density\")\n",
    "plt.xlabel(\"time\")\n",
    "plt.show()"
   ]
