    "from collections import UserDict\n",
    "\n",
    "class MyDict(UserDict):\n",
    "    def pop(self,s=None):\n",
    "        raise RuntimeError (\"deletion isn't allowed\")\n",
    "    \n",
    "    def __delete__(self):\n",
    "        raise RuntimeError(\"deletion not allowed\")\n",
    "\n",
    "d=MyDict({1:'a',2:'b',3:'c'})\n",
    "print(d)\n",
    "\n",
    "d.pop()"
